---
import '../styles/site.css';
import '../styles/extra.css';
import { getCollection } from 'astro:content';
import { LOGO_SVG } from '../lib/assets.js';
import { getSite, BASE, ORIGIN, abs } from '../lib/data.js';
import { createEngine } from '../lib/engine.js';
import famnavRaw from '../components/_famnav.html?raw';

interface Props {
  title?: string;            // 이 페이지 이름 (뒤에 | 마롱컴퍼니 가 붙습니다)
  fullTitle?: string;        // 통째로 지정할 때
  description?: string;
  path?: string;             // base 뒤 경로 (예: 'work/')
  image?: string;            // 공유용 이미지 (절대 주소)
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  jsonLd?: object[];
  article?: { published?: Date; modified?: Date; tags?: string[]; author?: string };
  nav?: 'home' | 'work' | 'about' | 'biz' | 'editorial' | 'find' | 'quote' | '';
  side?: 'work' | 'about' | 'home' | 'none';
  f?: string;                // 소재 페이지일 때 소재 id
  count?: number;            // 사이드 Layers 옆 숫자
  prevHref?: string;
  nextHref?: string;
  bodyClass?: string;
}
const {
  title = '', fullTitle = '', description = '', path = '', image = '', imageAlt = '', noindex = false, type = 'website',
  jsonLd = [], article, nav = '', side = 'none', f = 'all', count, prevHref = '', nextHref = '', bodyClass = '',
} = Astro.props;

const site = await getSite();
const S = site.settings;
const E = createEngine(site.ctx);
const U = E.U;
const posts = (await getCollection('editorial')).filter((e) => !e.data.draft);
const hasEditorial = posts.length > 0;

const pageTitle = fullTitle || (title ? title + ' | ' + S.siteName : S.siteName + ' | 조형물 · 건축미술 제작');
const desc = (description || S.siteDescription).replace(/\s+/g, ' ').trim();
const canonical = abs(path);
const ogImage = image || (S.ogImage ? abs(S.ogImage.replace(/^\/+/, '')) : abs('og-default.png'));

const SOCIAL = ['https://jenuek.github.io/stands-website/'];
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': ORIGIN + '/#org', name: S.siteName,
  alternateName: 'Malong Company', url: ORIGIN + '/', logo: abs('favicon.svg'),
  telephone: '+82-1644-4762', email: 'admin@malong.co.kr',
  address: { '@type': 'PostalAddress', streetAddress: '압구정로80길 14', addressLocality: '강남구', addressRegion: '서울특별시', postalCode: '06015', addressCountry: 'KR' },
  sameAs: SOCIAL,
};
const ld = [org, ...(path === '' ? [{ '@context': 'https://schema.org', '@type': 'WebSite', '@id': ORIGIN + '/#site', url: ORIGIN + '/', name: S.siteName, inLanguage: 'ko-KR' }] : []), ...jsonLd];

/* 사이드 */
const act = (f && f !== 'all') ? f : '';
let stackM = E.stackHTML();
if (act) stackM = stackM.replace('class="slab" data-slab="' + act + '"', 'class="slab on" data-slab="' + act + '"');
let stackA = E.stackAboutHTML();
stackA = stackA.replace('class="slab" data-a="s1"', 'class="slab on" data-a="s1"');
const famnav = famnavRaw.replace('{STANDS}', U('stands-logo.svg')).replace(/https:\/\/jenuek\.github\.io\/stands-website\//, site.STANDS_URL !== '#' ? site.STANDS_URL : 'https://jenuek.github.io/stands-website/');
const foot = (S.footer.length ? S.footer : [
  '(주)마롱컴퍼니 · 대표 이어진 · 사업자등록번호 472-81-00053',
  '(06015) 서울특별시 강남구 압구정로80길 14 · Tel 1644-4762 · admin@malong.co.kr',
]);
const cur = (k) => (nav === k ? 'page' : undefined);
const recruitExt = /^https?:/i.test(S.recruit);
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{pageTitle}</title>
<meta name="description" content={desc}>
<link rel="canonical" href={canonical}>
{noindex ? <meta name="robots" content="noindex,nofollow"> : <meta name="robots" content="index,follow,max-image-preview:large">}
<meta name="theme-color" content="#ffffff">
<link rel="icon" href={U('favicon.svg')} type="image/svg+xml">
{prevHref && <link rel="prev" href={abs(prevHref)}>}
{nextHref && <link rel="next" href={abs(nextHref)}>}
{hasEditorial && <link rel="alternate" type="application/rss+xml" title={S.siteName + ' Editorial'} href={U('editorial/rss.xml')}>}
<meta property="og:site_name" content={S.siteName}>
<meta property="og:locale" content="ko_KR">
<meta property="og:type" content={type}>
<meta property="og:title" content={fullTitle || title || S.siteName}>
<meta property="og:description" content={desc}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
{imageAlt && <meta property="og:image:alt" content={imageAlt}>}
{article?.published && <meta property="article:published_time" content={article.published.toISOString()}>}
{article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()}>}
{(article?.tags || []).map((t) => <meta property="article:tag" content={t}>)}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle || title || S.siteName}>
<meta name="twitter:description" content={desc}>
<meta name="twitter:image" content={ogImage}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@125,500..800&family=Noto+Sans+KR:wght@400;500;700;800&display=swap">
{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, '\\u003c')}></script>)}
<slot name="head" />
</head>
<body class={bodyClass} data-base={BASE}>
<a class="skip" href="#main">본문으로 건너뛰기</a>
<aside class="side" id="side" aria-label="사이트 메뉴">
  <a class="logo" href={U('')} aria-label="마롱컴퍼니 홈"><Fragment set:html={LOGO_SVG} /><b>Malong<br>Company</b></a>
  <nav class="nav" aria-label="주 메뉴">
    <a href={U('')} aria-current={cur('home')}>Home</a>
    <a href={U('business/arch/')} aria-current={cur('biz')}>Business</a>
    <a href={U('work/')} aria-current={cur('work')}>Work</a>
    <a href={U('about/')} aria-current={cur('about')}>About</a>
    {hasEditorial && <a href={U('editorial/')} aria-current={cur('editorial')}>Editorial</a>}
    <a href={U('find/')} aria-current={cur('find')}>소재 찾기 · 가견적</a>
    <a href={U('quote/')} aria-current={cur('quote')}>견적 문의</a>
    <a href={U('track.html')}>프로젝트 진행 확인</a>
    <Fragment set:html={famnav} />
  </nav>
  {side === 'work' && (
    <div class="pane" id="sp-m"><div><div class="lh"><span class="cap">Layers</span><span class="cap n" id="lcount">{String(count ?? site.PORT.length).padStart(2, '0')}</span></div><div class={'stk' + (act ? ' has-f' : '')} id="stkM" set:html={stackM}></div></div><div class="flt" id="fltM" role="group" aria-label="소재 분류" set:html={E.filtersHTML(act || 'all')}></div></div>
  )}
  {side === 'about' && (
    <div class="pane" id="sp-a"><div><div class="lh"><span class="cap">Layers</span><span class="cap n">06</span></div><div class="stk has-f" id="stkA" set:html={stackA}></div></div><div class="flt" id="fltA" role="navigation" aria-label="소개 목차" set:html={E.aboutFilterHTML()}></div></div>
  )}
  {side === 'home' && (
    <div class="side-ct" id="sideCt"><span class="cap">Contact</span><a href="tel:16444762">1644-4762</a><a href="mailto:admin@malong.co.kr">admin@malong.co.kr</a><small>서울특별시 강남구 압구정로80길 14</small></div>
  )}
  <div class="side-foot">© Malong Company</div>
</aside>
<header class="top" id="top">
  <div class="top-in"><a class="logo" href={U('')} aria-label="마롱컴퍼니 홈"><Fragment set:html={LOGO_SVG} /></a>
    <div style="display:flex;gap:14px;align-items:baseline">
      <a class="g" href={U('business/arch/')} aria-current={cur('biz')}>Business</a>
      <a class="g" href={U('work/')} aria-current={cur('work')}>Work</a>
      <a class="g" href={U('about/')} aria-current={cur('about')}>About</a>
      {hasEditorial && <a class="g" href={U('editorial/')} aria-current={cur('editorial')}>Editorial</a>}
      <a class="g" href={U('find/')} aria-current={cur('find')}>소재 찾기</a>
      <a class="g" href={U('quote/')} aria-current={cur('quote')}>견적 문의</a>
      <a class="g" href={U('track.html')}>진행 확인</a>
    </div>
  </div>
  {side === 'work' && <div class="mchips" id="mchipsM" role="group" aria-label="소재 분류" set:html={E.chipsHTML(act || 'all')}></div>}
  {side === 'about' && <div class="mchips" id="mchipsA" role="navigation" aria-label="소개 목차" set:html={E.aboutChipsHTML()}></div>}
</header>
<main id="main">
  <slot />
  <footer class="foot">
    <nav class="fnav" aria-label="하단 메뉴"><a href={U('business/arch/')}>사업분야</a>{hasEditorial && <a href={U('editorial/')}>Editorial</a>}<a href={S.recruit} target={recruitExt ? '_blank' : undefined} rel={recruitExt ? 'noopener' : undefined}>채용</a><a href={U('find/')}>소재 찾기</a><a href={U('quote/')}>견적 문의</a><a href={U('track.html')}>진행 확인</a><a href={U('privacy/')}>개인정보처리방침</a></nav>
    <span set:html={foot.map((t) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]))).join('<br>')}></span>
    <span class="famf"><a href={site.STANDS_URL !== '#' ? site.STANDS_URL : 'https://jenuek.github.io/stands-website/'} target="_blank" rel="noopener"><img src={U('stands-logo.svg')} alt="STANDS" width="140" height="35"><i>↗</i></a><small class="fcap">아트 큐레이션 · 건축미술 · 전시</small><span class="cap">© Malongcompany Co.Ltd.</span></span>
  </footer>
</main>
<div class="fab" id="fab" role="navigation" aria-label="빠른 메뉴">
  <a class="fab-b" href={U('find/')}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg><span>소재 찾기</span></a>
  <a class="fab-b pri" href={U('quote/')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h16v11H9l-4 3.5v-3.5H4z"/><path d="M8 10h8M8 13h5"/></svg><span>견적 문의</span></a>
</div>
<script>import '../scripts/chrome.js';</script>
<slot name="scripts" />
</body>
</html>
