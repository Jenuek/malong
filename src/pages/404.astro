---
import Base from '../layouts/Base.astro';
import { createEngine } from '../lib/engine.js';
import { getSite } from '../lib/data.js';
const site = await getSite();
const U = createEngine(site.ctx).U;
---
<Base title="페이지를 찾을 수 없어요" description="요청하신 페이지를 찾을 수 없습니다." path="404.html" noindex={true} nav="">
  <div class="nf">
    <h1>404</h1>
    <p>찾으시는 페이지가 없거나 주소가 바뀌었어요.</p>
    <div class="go"><a href={U('work/')}>작품 보러 가기<span>→</span></a><a href={U('')}>홈으로<span>→</span></a></div>
  </div>
</Base>
