---
import Base from '../../layouts/Base.astro';
import '../../styles/guide.css';
import { BASE } from '../../lib/data.js';
---
<Base title="조형물 소재 찾기 · 가견적" description="몇 가지만 고르면 나에게 맞는 조형물 소재를 알려드려요. 소재별 특성, 한눈에 비교, 가견적 범위까지 한 번에 확인하세요." path="find/" nav="find" bodyClass="gd-page">
  <div id="app" class="gd"></div>
  <noscript><p style="padding:24px">이 페이지는 자바스크립트가 필요해요. 문의는 1644-4762 또는 admin@malong.co.kr 로 주세요.</p></noscript>
  <Fragment slot="scripts">
    <script is:inline>window.GUIDE_MODE = 'find';</script>
    <script is:inline src={BASE + 'assets/guide.js'}></script>
  </Fragment>
</Base>
